# ==========================================
# Offline AI Stack Configuration
# ==========================================

# FastAPI Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=tinyllama
EMBEDDING_MODEL=nomic-embed-text

# Docker Configuration
DOCKER_NETWORK=offline-ai-net

# Qdrant Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=rag_documents

# Language Settings (en for English, de for German)
APP_LANGUAGE=en

# OpenWebUI Configuration
OPENWEBUI_PORT=3000
OPENWEBUI_AUTH=false
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.9.6

# n8n Automation Server Configuration
N8N_PORT=5678

# Storage Directories (Relative or absolute paths)
DATA_DIR=./data
QDRANT_STORAGE_DIR=./data/qdrant
OPENWEBUI_STORAGE_DIR=./data/openwebui
N8N_STORAGE_DIR=./data/n8n
KOKORO_STORAGE_DIR=./data/kokoro
INGESTION_DIR=./data/ingest

# Offline Text-to-Speech (Kokoro) Settings
KOKORO_PORT=8880
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.3.0
# Voice option (e.g. af_sky, af_sarah, af_bella for English; martin for German ONNX)
KOKORO_VOICE=af_sky
KOKORO_MODEL=kokoro
ENABLE_TTS=true

# Offline Text-to-Speech (CosyVoice - Thorsten) Settings
COSYVOICE_PORT=8008
COSYVOICE_IMAGE=thorstenvoice/cosyvoice-tts:cosyvoice3
COSYVOICE_STORAGE_DIR=./data/cosyvoice
ENABLE_COSYVOICE=true


# Offline Speech-to-Text (Whisper) Settings
ENABLE_STT=true
WHISPER_MODEL=base
WHISPER_STORAGE_DIR=./data/whisper
