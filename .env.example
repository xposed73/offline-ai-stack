# ==========================================
# Offline AI Stack Configuration
# ==========================================

# FastAPI Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:32b
EMBEDDING_MODEL=bge-m3

# Docker Configuration
DOCKER_NETWORK=offline-ai-net

# Qdrant Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=rag_documents

# OpenWebUI Configuration
OPENWEBUI_PORT=3000

# n8n Automation Server Configuration
N8N_PORT=5678

# Storage Directories (Relative or absolute paths)
DATA_DIR=./data
QDRANT_STORAGE_DIR=./data/qdrant
OPENWEBUI_STORAGE_DIR=./data/openwebui
N8N_STORAGE_DIR=./data/n8n
KOKORO_STORAGE_DIR=./data/kokoro
INGESTION_DIR=./data/ingest

# Offline Text-to-Speech (Kokoro) Settings
KOKORO_PORT=8880
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.3.0
# Voice option (e.g. af_sky, af_sarah, af_bella for English; de_female_1 for German)
KOKORO_VOICE=af_sky
KOKORO_MODEL=kokoro
ENABLE_TTS=true
